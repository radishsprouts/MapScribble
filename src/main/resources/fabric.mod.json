{
  "schemaVersion": 1,
  "id": "mapscribble",
  "version": "${version}",
  "name": "MapScribble",
  "description": "Handwritten notes and scribbles on full-screen and mini maps (JourneyMap, Xaero's World Map, FTB Chunks). Client-side only.",
  "authors": [
    "radishsprouts"
  ],
  "contact": {
    "sources": "https://github.com/radishsprouts/MapScribble",
    "issues": "https://github.com/radishsprouts/MapScribble/issues",
    "homepage": "https://github.com/radishsprouts/MapScribble"
  },
  "license": "MIT",
  "icon": "assets/mapscribble/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "io.github.radishsprouts.mapscribble.MapScribble"
    ],
    "journeymap": [
      "io.github.radishsprouts.mapscribble.jm.MapScribblePlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  },
  "suggests": {
    "journeymap": "*",
    "xaeroworldmap": "*",
    "ftbchunks": "*"
  }
}
